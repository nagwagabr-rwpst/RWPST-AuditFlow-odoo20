<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="auditflow_standard.AuditDashboard">
        <div class="o_audit_dashboard o_audit_dashboard_container">
            <header class="o_audit_dashboard_header o_audit_dashboard_hero dashboard-header">
                <div class="o_audit_dashboard_header_text">
                    <h1 class="o_audit_dashboard_title" t-esc="this.dashboardTexts.pageTitle"/>
                    <p class="o_audit_dashboard_subtitle" t-esc="this.dashboardTexts.pageSubtitle"/>
                </div>
                <span class="o_audit_dashboard_badge" t-esc="this.dashboardTexts.badgeMvp"/>
            </header>

            <t t-if="!this.state.loading and !this.state.errorKey">
                <div class="o_audit_filter_bar dashboard-filters audit-dashboard-filters">
                    <div class="o_audit_filter_bar_inner">
                        <div class="o_audit_filter_group">
                            <label class="o_audit_filter_label" t-esc="this.dashboardTexts.filterAuditor"/>
                            <select
                                class="o_audit_filter_select"
                                t-att-value="this.state.activeFilters.auditor_id"
                                t-on-change="(ev) => this.onFilterChange('auditor_id', ev.target.value)"
                                t-att-disabled="this.state.filtersLoading">
                                <option value="" t-esc="this.dashboardTexts.allAuditors"/>
                                <t t-foreach="this.state.filtersData.auditors || []" t-as="auditor" t-key="auditor.id">
                                    <option t-att-value="auditor.id" t-esc="auditor.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="o_audit_filter_group">
                            <label class="o_audit_filter_label" t-esc="this.dashboardTexts.filterAuditee"/>
                            <select
                                class="o_audit_filter_select"
                                t-att-value="this.state.activeFilters.auditee_id"
                                t-on-change="(ev) => this.onFilterChange('auditee_id', ev.target.value)"
                                t-att-disabled="this.state.filtersLoading">
                                <option value="" t-esc="this.dashboardTexts.allAuditees"/>
                                <t t-foreach="this.state.filtersData.auditees || []" t-as="auditee" t-key="auditee.id">
                                    <option t-att-value="auditee.id" t-esc="auditee.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="o_audit_filter_group">
                            <label class="o_audit_filter_label" t-esc="this.dashboardTexts.filterStatus"/>
                            <select
                                class="o_audit_filter_select"
                                t-att-value="this.state.activeFilters.status"
                                t-on-change="(ev) => this.onFilterChange('status', ev.target.value)"
                                t-att-disabled="this.state.filtersLoading">
                                <option value="" t-esc="this.dashboardTexts.allStatuses"/>
                                <t t-foreach="this.statusFilterOptions" t-as="opt" t-key="opt.value">
                                    <option t-att-value="opt.value" t-esc="opt.label"/>
                                </t>
                            </select>
                        </div>
                        <div class="o_audit_filter_group">
                            <label class="o_audit_filter_label" t-esc="this.dashboardTexts.filterSeverity"/>
                            <select
                                class="o_audit_filter_select"
                                t-att-value="this.state.activeFilters.severity"
                                t-on-change="(ev) => this.onFilterChange('severity', ev.target.value)"
                                t-att-disabled="this.state.filtersLoading">
                                <option value="" t-esc="this.dashboardTexts.allSeverities"/>
                                <t t-foreach="this.severityFilterOptions" t-as="opt" t-key="opt.value">
                                    <option t-att-value="opt.value" t-esc="opt.label"/>
                                </t>
                            </select>
                        </div>
                        <div class="o_audit_filter_actions">
                            <button
                                type="button"
                                class="btn btn-primary o_audit_refresh_button"
                                t-att-disabled="this.state.dashboardRefreshing || this.state.filtersLoading"
                                t-on-click="() => this.refreshDashboard()">
                                <i class="fa fa-refresh me-1" aria-hidden="true"></i>
                                <span t-esc="this.dashboardTexts.refresh"/>
                            </button>
                        </div>
                    </div>
                    <p class="o_audit_filter_hint mb-0" t-esc="this.dashboardTexts.filtersHint"/>
                </div>
                <t t-if="this.state.dashboardRefreshing">
                    <div class="o_audit_refresh_banner text-muted" role="status">
                        <i class="fa fa-spinner fa-spin me-2" aria-hidden="true"></i>
                        <span t-esc="this.dashboardTexts.bannerRefreshing"/>
                    </div>
                </t>
            </t>

            <t t-if="this.state.loading">
                <div class="o_audit_dashboard_loading" role="status">
                    <i class="fa fa-spinner fa-spin me-2" aria-hidden="true"></i>
                    <span t-esc="this.dashboardTexts.loadingDashboard"/>
                </div>
            </t>

            <t t-if="this.errorMessage">
                <div class="o_audit_dashboard_error alert alert-danger" role="alert">
                    <i class="fa fa-exclamation-circle me-2" aria-hidden="true"></i>
                    <t t-esc="this.errorMessage"/>
                </div>
            </t>

            <t t-if="!this.state.loading and !this.state.errorKey">
                <div t-att-class="'o_audit_kpi_grid audit-kpi-grid dashboard-kpi-grid' + (this.state.dashboardRefreshing ? ' o_audit_dashboard_refreshing' : '')">
                    <t t-foreach="this.metricCards" t-as="card" t-key="card.key">
                        <div t-att-class="this.cardClass(card)"
                             role="button"
                             tabindex="0"
                             t-on-click="() => this.selectMetric(card.key)">
                            <span t-att-class="'o_audit_kpi_icon ' + card.icon" aria-hidden="true"></span>
                            <div class="o_audit_kpi_meta">
                                <span class="o_audit_kpi_label" t-esc="card.label"/>
                                <span class="o_audit_kpi_value" t-esc="this.kpiValue(card.key)"/>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="o_audit_dashboard_main">
                    <section class="o_audit_chart_panel" aria-labelledby="audit-chart-heading">
                        <h2 id="audit-chart-heading" class="o_audit_chart_heading" t-esc="this.dashboardTexts.headingSelectedMetric"/>

                        <div class="o_audit_chart_toolbar">
                            <strong class="o_audit_chart_toolbar_title" t-esc="this.selectedMetricLabel"/>
                            <span class="o_audit_chart_type_badge" t-esc="this.chartTypeLabel"/>
                        </div>

                        <p class="o_audit_chart_meta_line">
                            <span class="text-muted"><t t-esc="this.dashboardTexts.technicalKeyCaption"/>:</span>
                            <!-- <code t-esc="this.state.selectedMetric"/>-->
                            <code t-esc="this.selectedMetricLabel"/>
                        </p>

                        <t t-if="this.state.graphLoading">
                            <div class="o_audit_chart_loading text-muted" role="status">
                                <i class="fa fa-spinner fa-spin me-2" aria-hidden="true"></i>
                                <span t-esc="this.dashboardTexts.loadingChart"/>
                            </div>
                        </t>

                        <t t-if="this.graphErrorMessage">
                            <div class="o_audit_chart_error alert alert-warning mb-0" role="alert">
                                <t t-esc="this.graphErrorMessage"/>
                            </div>
                        </t>

                        <t t-if="!this.state.graphLoading and !this.state.graphErrorKey and this.graphRowCount == 0">
                            <div class="o_audit_chart_empty text-muted" t-esc="this.dashboardTexts.noChartData"/>
                        </t>

                        <div class="o_audit_chart_body chart-container" t-if="!this.state.graphLoading and !this.state.graphErrorKey and this.graphRowCount > 0">
                            <t t-if="this.chartType == 'bar'">
                                <div class="o_audit_bar_chart">
                                    <t t-foreach="this.graphRows" t-as="row" t-key="row_index">
                                        <div class="o_audit_bar_row">
                                            <div class="o_audit_bar_label text-truncate" t-esc="row.label"/>
                                            <div class="o_audit_bar_track">
                                                <div class="o_audit_bar_fill" t-attf-style="width: #{row.percent}%"></div>
                                            </div>
                                            <div class="o_audit_bar_value" t-esc="row.value"/>
                                        </div>
                                    </t>
                                </div>
                            </t>

                            <t t-if="this.chartType == 'line'">
                                <div class="o_audit_line_chart">
                                    <t t-foreach="this.graphRows" t-as="row" t-key="row_index">
                                        <div class="o_audit_line_point">
                                            <span class="o_audit_line_value" t-esc="row.value"/>
                                            <span class="o_audit_line_chip"></span>
                                            <span class="o_audit_line_label text-truncate" t-esc="row.label"/>
                                        </div>
                                    </t>
                                </div>
                            </t>

                            <t t-if="this.chartType == 'donut'">
                                <div class="o_audit_donut_chart">
                                    <div class="o_audit_donut_visual" t-att-style="this.donutRingStyleAttr">
                                        <div class="o_audit_donut_center">
                                            <strong class="o_audit_donut_total" t-esc="this.graphTotal"/>
                                            <span class="o_audit_donut_total_label" t-esc="this.dashboardTexts.donutTotal"/>
                                        </div>
                                    </div>
                                    <div class="o_audit_donut_legend">
                                        <t t-foreach="this.graphRows" t-as="row" t-key="row_index">
                                            <div class="o_audit_donut_legend_item">
                                                <div class="o_audit_donut_legend_row">
                                                    <span class="o_audit_donut_swatch" t-attf-style="background: #{this.donutSliceColor(row_index)}"></span>
                                                    <span class="o_audit_donut_label text-truncate" t-esc="row.label"/>
                                                    <strong class="o_audit_donut_legend_value" t-esc="row.value"/>
                                                    <span class="o_audit_donut_pct text-muted">
                                                        (<t t-esc="this.donutSlicePercent(row_index)"/>%)
                                                    </span>
                                                </div>
                                                <div class="o_audit_donut_mini_track">
                                                    <div class="o_audit_donut_mini_fill" t-attf-style="width: #{this.donutSlicePercent(row_index)}%; background: #{this.donutSliceColor(row_index)}"></div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </section>
                    <aside class="o_audit_dashboard_sidebar">
                        <section class="o_audit_insight_panel">
                            <h3 class="o_audit_insight_title" t-esc="this.dashboardTexts.insightTitle"/>
                            <div class="o_audit_insight_metrics">
                                <div class="o_audit_insight_metric">
                                    <span class="o_audit_insight_metric_label" t-esc="this.dashboardTexts.insightMetric"/>
                                    <span class="o_audit_insight_metric_value" t-esc="this.selectedMetricLabel"/>
                                </div>
                                <div class="o_audit_insight_metric">
                                    <span class="o_audit_insight_metric_label" t-esc="this.dashboardTexts.insightChartTotal"/>
                                    <span class="o_audit_insight_metric_value" t-esc="this.graphTotal"/>
                                </div>
                                <div class="o_audit_insight_metric">
                                    <span class="o_audit_insight_metric_label" t-esc="this.dashboardTexts.insightChartType"/>
                                    <span class="o_audit_insight_metric_value" t-esc="this.chartTypeLabel"/>
                                </div>
                            </div>
                            <p class="o_audit_insight_text mb-0" t-esc="this.dashboardTexts.insightBody"/>
                        </section>
                        <section class="o_audit_powerbi_panel">
                            <h3 class="o_audit_powerbi_title" t-esc="this.dashboardTexts.powerBiTitle"/>
                            <span class="o_audit_powerbi_badge" t-esc="this.dashboardTexts.powerBiBadge"/>
                            <p class="o_audit_powerbi_text mb-2" t-esc="this.dashboardTexts.powerBiBody"/>
                            <span class="o_audit_powerbi_coming_soon" t-esc="this.dashboardTexts.comingSoon"/>
                        </section>
                    </aside>
                </div>
            </t>
        </div>
    </t>
</templates>
