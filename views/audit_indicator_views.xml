<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_audit_indicator_tree" model="ir.ui.view">
            <field name="name">audit.indicator.stable.list</field>
            <field name="model">audit.indicator.stable</field>
            <field name="arch" type="xml">
                <list string="Audit Indicators" class="o_auditflow_list">
                    <field name="name"/>
                    <field name="plan_id"/>
                    <field name="category"/>
                    <field name="current_value"/>
                    <field name="target"/>
                    <field name="score" widget="progressbar"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_audit_indicator_form" model="ir.ui.view">
            <field name="name">audit.indicator.stable.form</field>
            <field name="model">audit.indicator.stable</field>
            <field name="arch" type="xml">
                <form class="o_auditflow_form">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Indicator"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="plan_id"/>
                                <field name="category"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="baseline"/>
                                <field name="target"/>
                                <field name="current_value"/>
                                <field name="score" widget="progressbar"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_audit_indicator" model="ir.actions.act_window">
            <field name="name">Audit Indicators</field>
            <field name="res_model">audit.indicator.stable</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
