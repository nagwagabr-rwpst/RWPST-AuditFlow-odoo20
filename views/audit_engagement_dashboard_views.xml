<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_audit_engagement_graph_readiness" model="ir.ui.view">
            <field name="name">audit.engagement.graph.readiness</field>
            <field name="model">audit.engagement</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <graph string="Report readiness" type="bar" sample="1" class="o_auditflow_graph">
                    <field name="readiness_label" type="row"/>
                </graph>
            </field>
        </record>

        <record id="view_audit_engagement_graph" model="ir.ui.view">
            <field name="name">audit.engagement.graph</field>
            <field name="model">audit.engagement</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <graph string="Audit operations by execution status" type="bar" sample="1" class="o_auditflow_graph">
                    <field name="state" type="row"/>
                </graph>
            </field>
        </record>

        <record id="view_audit_engagement_pivot" model="ir.ui.view">
            <field name="name">audit.engagement.pivot</field>
            <field name="model">audit.engagement</field>
            <field name="arch" type="xml">
                <pivot string="Audit operations" sample="1" class="o_auditflow_pivot">
                    <field name="state" type="row"/>
                    <field name="company_id" type="row"/>
                </pivot>
            </field>
        </record>

        <record id="action_audit_engagement_dashboard" model="ir.actions.act_window">
            <field name="name">Operations overview</field>
            <field name="res_model">audit.engagement</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_audit_engagement_search"/>
        </record>

        <record id="action_not_ready_engagements" model="ir.actions.act_window">
            <field name="name">Operations not report-ready</field>
            <field name="res_model">audit.engagement</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_not_ready', '=', True)]</field>
            <field name="search_view_id" ref="view_audit_engagement_search"/>
        </record>

        <record id="action_overdue_findings" model="ir.actions.act_window">
            <field name="name">Delayed Review Results</field>
            <field name="res_model">audit.finding</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_overdue', '=', True)]</field>
            <field name="search_view_id" ref="view_audit_finding_search"/>
        </record>

        <menuitem id="menu_audit_engagement_dashboard"
                  name="Operations overview"
                  parent="menu_smart_audit_section_analytics"
                  action="action_audit_engagement_dashboard"
                  sequence="5"/>

        <menuitem id="menu_audit_not_ready_engagements"
                  name="Operations not report-ready"
                  parent="menu_smart_audit_section_engagements"
                  action="action_not_ready_engagements"
                  sequence="10"/>

        <menuitem id="menu_audit_overdue_findings"
                  name="Delayed Review Results"
                  parent="menu_smart_audit_section_findings"
                  action="action_overdue_findings"
                  sequence="10"/>
    </data>
</odoo>
