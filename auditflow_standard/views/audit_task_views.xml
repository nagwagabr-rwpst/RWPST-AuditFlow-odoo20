<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_audit_task_tree" model="ir.ui.view">
            <field name="name">audit.task.stable.list</field>
            <field name="model">audit.task.stable</field>
            <field name="arch" type="xml">
                <list string="Audit Tasks" class="o_auditflow_list" multi_edit="1"
                      decoration-success="status == 'done'"
                      decoration-info="status == 'in_progress'">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="plan_id"/>
                    <field name="assigned_to"/>
                    <field name="status" widget="badge"/>
                    <field name="due_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_audit_task_form" model="ir.ui.view">
            <field name="name">audit.task.stable.form</field>
            <field name="model">audit.task.stable</field>
            <field name="arch" type="xml">
                <form class="o_auditflow_form">
                    <header>
                        <button name="action_start" type="object" string="Start"
                                class="oe_highlight" invisible="status != 'pending'"/>
                        <button name="action_done" type="object" string="Mark Done"
                                class="oe_highlight" invisible="status == 'done'"/>
                        <field name="status" widget="statusbar"
                               statusbar_visible="pending,in_progress,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Task"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="plan_id"/>
                                <field name="assigned_to"/>
                            </group>
                            <group>
                                <field name="due_date"/>
                                <field name="sequence"/>
                                <field name="active"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="Note">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

    </data>
</odoo>
