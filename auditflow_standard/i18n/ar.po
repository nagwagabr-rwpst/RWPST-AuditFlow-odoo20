#. module: auditflow_standard
# ===== DEMO DATA (Audit Video Scenario - Final No Automation Claims) =====
#: model:audit.finding,name:demo_audit_finding_eg1_doc_po
msgid "Control weakness in purchase documentation"
msgstr "ضعف رقابي في توثيق أوامر الشراء"

#. module: auditflow_standard
#: model:audit.finding,description:demo_audit_finding_eg1_doc_po
msgid ""
"Hero Case CF-001: During audit review of the procurement-to-pay cycle, the "
"audit team noted purchase orders approved with incomplete receipt evidence "
"and missing technical sign-off. This was recorded as the first weakness in "
"the payment control chain."
msgstr ""
"حالة رئيسية CF-001: خلال مراجعة دورة الشراء إلى الدفع، لاحظ فريق المراجعة "
"وجود أوامر شراء معتمدة مع نقص في أدلة الاستلام وغياب الاعتماد الفني. وتم "
"تسجيل ذلك كأول نقطة ضعف في سلسلة الرقابة على المدفوعات."

#. module: auditflow_standard
#: model:audit.finding,root_cause:demo_audit_finding_eg1_doc_po
msgid ""
"Mandatory verification steps were not consistently completed before "
"procurement documents moved toward payment review."
msgstr ""
"لم تكن خطوات التحقق الإلزامية تُستكمل بشكل منتظم قبل انتقال مستندات "
"المشتريات إلى مرحلة مراجعة الدفع."

#. module: auditflow_standard
#: model:audit.finding,impact:demo_audit_finding_eg1_doc_po
msgid ""
"Incomplete documentation weakened the audit trail and increased the risk of "
"unsupported payments."
msgstr ""
"أدى نقص التوثيق إلى إضعاف مسار المراجعة وزيادة مخاطر وجود مدفوعات غير مدعومة"
" بالمستندات."

#. module: auditflow_standard
#: model:audit.finding,recommendation:demo_audit_finding_eg1_doc_po
msgid ""
"Require complete receipt evidence, technical sign-off, and purchase order "
"documentation before payment review."
msgstr ""
"اشتراط اكتمال أدلة الاستلام والاعتماد الفني وتوثيق أمر الشراء قبل مراجعة "
"الدفع."

#. module: auditflow_standard
#: model:audit.finding,action_plan:demo_audit_finding_eg1_doc_po
msgid ""
"Procurement will update the review checklist and assign ownership for "
"document completeness before payment routing."
msgstr ""
"ستقوم إدارة المشتريات بتحديث قائمة المراجعة وتحديد مسؤولية اكتمال المستندات "
"قبل توجيهها لمراجعة الدفع."

#. module: auditflow_standard
#: model:audit.finding,management_response:demo_audit_finding_eg1_doc_po
msgid ""
"Management acknowledged the documentation gap and agreed to coordinate with "
"Finance on the corrective path."
msgstr ""
"أقرت الإدارة بوجود فجوة في التوثيق ووافقت على التنسيق مع الإدارة المالية "
"بشأن مسار التصحيح."

#. module: auditflow_standard
#: model:audit.finding,description:demo_audit_finding_eg2_payment
msgid ""
"Hero Case CF-001: During audit sample testing of the payment cycle, the "
"audit team identified a payment case where the purchase order, receipt "
"confirmation, and invoice validation were not fully aligned. Similar "
"exceptions were observed across multiple samples, indicating a recurring "
"control weakness rather than an isolated case."
msgstr ""
"حالة رئيسية CF-001: خلال اختبار عينات من دورة المدفوعات، حدد فريق المراجعة "
"حالة دفع لم يكن فيها تطابق كامل بين أمر الشراء، وتأكيد الاستلام، واعتماد "
"الفاتورة. وتمت ملاحظة استثناءات مشابهة في عدة عينات، مما يشير إلى ضعف رقابي "
"متكرر وليس حالة منفردة."

#. module: auditflow_standard
#: model:audit.finding,root_cause:demo_audit_finding_eg2_payment
msgid ""
"Payment review relied on manual follow-up without a consistently documented "
"three-way match control."
msgstr ""
"اعتمدت مراجعة المدفوعات على المتابعة اليدوية دون وجود توثيق منتظم لرقابة "
"المطابقة الثلاثية."

#. module: auditflow_standard
#: model:audit.finding,impact:demo_audit_finding_eg2_payment
msgid ""
"The issue exposed the company to financial leakage, duplicate payment risk, "
"weak evidence, and audit non-compliance."
msgstr ""
"عرّضت هذه المشكلة الشركة لمخاطر تسرب مالي، واحتمال تكرار المدفوعات، وضعف "
"الأدلة، وعدم الالتزام بمتطلبات المراجعة."

#. module: auditflow_standard
#: model:audit.finding,recommendation:demo_audit_finding_eg2_payment
msgid ""
"Require documented three-way match evidence before payment approval, with "
"formal exception approval where needed."
msgstr ""
"اشتراط وجود أدلة موثقة للمطابقة الثلاثية قبل اعتماد الدفع، مع اعتماد رسمي "
"للاستثناءات عند الحاجة."

#. module: auditflow_standard
#: model:audit.finding,action_plan:demo_audit_finding_eg2_payment
msgid ""
"Finance will prepare a weekly exception list, assign responsible owners, and"
" escalate unmatched payments for management review."
msgstr ""
"ستقوم الإدارة المالية بإعداد قائمة أسبوعية بالاستثناءات، وتحديد الملاك "
"المسؤولين، وتصعيد المدفوعات غير المطابقة لمراجعة الإدارة."

#. module: auditflow_standard
#: model:audit.finding,management_response:demo_audit_finding_eg2_payment
msgid ""
"Initial management response was delayed; Audit escalated the matter due to "
"the critical financial exposure."
msgstr ""
"تأخر رد الإدارة المبدئي؛ وقام فريق المراجعة بتصعيد الموضوع بسبب حجم التعرض "
"المالي الحرج."

#. module: auditflow_standard
#: model:audit.finding,description:demo_audit_finding_eg2_inreview
msgid ""
"Hero Case CF-001: During follow-up, the audit team noted that settlement "
"approvals for unmatched payments remained pending without a clear logged "
"reason, delaying closure of the critical payment finding."
msgstr ""
"حالة رئيسية CF-001: خلال المتابعة، لاحظ فريق المراجعة أن اعتمادات التسوية "
"للمدفوعات غير المطابقة ما زالت معلقة دون سبب موثق بوضوح، مما أدى إلى تأخير "
"إغلاق ملاحظة الدفع الحرجة."

#. module: auditflow_standard
#: model:audit.finding,root_cause:demo_audit_finding_eg2_inreview
msgid ""
"Settlement ownership changed without formal handover or sufficient "
"visibility in the approval path."
msgstr "تغير مالك التسوية دون تسليم رسمي أو وضوح كافٍ في مسار الاعتماد."

#. module: auditflow_standard
#: model:audit.finding,impact:demo_audit_finding_eg2_inreview
msgid ""
"Delayed approval extended the exposure window and slowed management’s "
"ability to correct the payment control weakness."
msgstr ""
"أدى تأخر الاعتماد إلى إطالة فترة التعرض للمخاطر وإبطاء قدرة الإدارة على "
"معالجة ضعف الرقابة على المدفوعات."

#. module: auditflow_standard
#: model:audit.finding,recommendation:demo_audit_finding_eg2_inreview
msgid ""
"Define a named settlement owner, visible approval status, and escalation "
"rule for overdue payment exceptions."
msgstr ""
"تحديد مالك واضح للتسوية، وحالة اعتماد ظاهرة، وقاعدة تصعيد للاستثناءات "
"المتأخرة في المدفوعات."

#. module: auditflow_standard
#: model:audit.finding,action_plan:demo_audit_finding_eg2_inreview
msgid ""
"Finance and Procurement will standardize the settlement path, assign a "
"single accountable owner, and review overdue exceptions weekly."
msgstr ""
"ستقوم إدارتا المالية والمشتريات بتوحيد مسار التسوية، وتعيين مالك مسؤول واحد،"
" ومراجعة الاستثناءات المتأخرة أسبوعياً."

#. module: auditflow_standard
#: model:audit.finding,management_response:demo_audit_finding_eg2_inreview
msgid ""
"Management approved an escalation workshop and assigned Finance as the "
"accountable owner for settlement closure."
msgstr ""
"وافقت الإدارة على ورشة عمل للتصعيد وعيّنت الإدارة المالية كمالك مسؤول عن "
"إغلاق التسويات."

#. module: auditflow_standard
#: model:audit.corrective.action,name:demo_corrective_action_payment_critical
msgid "Prepare three-way match exception report"
msgstr "إعداد تقرير استثناءات المطابقة الثلاثية"

#. module: auditflow_standard
#: model:audit.corrective.action,description:demo_corrective_action_payment_critical
msgid ""
"Prepare a weekly audit follow-up report listing payments, invoices, or "
"receipts that do not have complete three-way match evidence."
msgstr ""
"إعداد تقرير متابعة أسبوعي للمراجعة يتضمن المدفوعات أو الفواتير أو مستندات "
"الاستلام التي لا تحتوي على أدلة مكتملة للمطابقة الثلاثية."

#. module: auditflow_standard
#: model:audit.corrective.action,followup_notes:demo_corrective_action_payment_critical
msgid ""
"Hero Case CF-001: No corrective action has been initiated following audit "
"escalation. This item should appear as the urgent action in the executive "
"demo dashboard."
msgstr ""
"حالة رئيسية CF-001: لم يبدأ أي إجراء تصحيحي بعد تصعيد المراجعة. يجب أن يظهر "
"هذا البند كإجراء عاجل في لوحة العرض التنفيذية."

#. module: auditflow_standard
#: model:audit.corrective.action,name:demo_corrective_action_procurement_assigned
msgid "Strengthen PO evidence before payment review"
msgstr "تعزيز أدلة أمر الشراء قبل مراجعة الدفع"

#. module: auditflow_standard
#: model:audit.corrective.action,description:demo_corrective_action_procurement_assigned
msgid ""
"Update procurement review steps so payment review is not requested until PO "
"evidence, receipt evidence, and technical sign-off are complete."
msgstr ""
"تحديث خطوات مراجعة المشتريات بحيث لا يتم طلب مراجعة الدفع إلا بعد اكتمال "
"أدلة أمر الشراء، وأدلة الاستلام، والاعتماد الفني."

#. module: auditflow_standard
#: model:audit.corrective.action,followup_notes:demo_corrective_action_procurement_assigned
msgid ""
"Hero Case CF-001: This assigned corrective action represents the first "
"containment step before Finance completes the payment exception follow-up."
msgstr ""
"حالة رئيسية CF-001: يمثل هذا الإجراء التصحيحي المسند أول خطوة احتواء قبل أن "
"تستكمل الإدارة المالية متابعة استثناءات الدفع."

#. module: auditflow_standard
#. odoo-javascript
#: code:addons/auditflow_standard/static/src/js/audit_dashboard.js:0
msgid "Update"
msgstr "تحديث"
