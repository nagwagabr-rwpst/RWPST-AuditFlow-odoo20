<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_audit_plan_stable" model="ir.sequence">
            <field name="name">Audit Plan</field>
            <field name="code">audit.plan.stable</field>
            <field name="prefix">AUD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_audit_engagement" model="ir.sequence">
            <field name="name">Audit Operation</field>
            <field name="code">audit.engagement</field>
            <field name="prefix">ENG/%(year)s/</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True"/>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>
